<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;</TargetFrameworks>
		<Nullable>enable</Nullable>
		<Version>0.0.23</Version>
		<Authors>Raypro</Authors>
		<IsPackable>true</IsPackable>
		<LangVersion>10.0</LangVersion>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-logging</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.com/rayprosoft/tgs-logging.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Tgs Logging</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Tgs.Logging</PackageId>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MessagePack" Version="2.5.172" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="8.0.0" />
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.11.20">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
    <PackageReference Include="PhoenixToolkits.MessageQueue.Nats" Version="2.1.2" />
    <PackageReference Include="Tgs.Logging.Models" Version="0.0.21" />
    <PackageReference Include="Tgs.MessageQueue.Nats.Serializers" Version="0.0.2" />
	</ItemGroup>

</Project>
